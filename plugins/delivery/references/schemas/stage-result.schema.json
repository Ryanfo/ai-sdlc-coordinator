{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "specification",
        "plan",
        "footprint",
        "architecture",
        "review",
        "verification",
        "release",
        "release_verification",
        "code",
        "test",
        "doc"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Deviation": {
      "additionalProperties": false,
      "description": "Working behaviour that differs from the approved specification (added, changed or,\nwhen the developer asked for it, dropped). Not a defect: a human decides whether it is\nacceptable. Accepted, the specification is rewritten to include it; not accepted,\ndevelopment changes the code to follow the specification.",
      "properties": {
        "id": {
          "pattern": "^D\\d{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "criterion_id": {
          "anyOf": [
            {
              "pattern": "^AC\\d{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criterion Id"
        },
        "requested": {
          "default": false,
          "title": "Requested",
          "type": "boolean"
        },
        "request": {
          "default": "",
          "maxLength": 1000,
          "title": "Request",
          "type": "string"
        },
        "spec_change": {
          "default": "",
          "maxLength": 4000,
          "title": "Spec Change",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "Deviation",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^AC\\d{1,3}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "status": {
          "default": "defined",
          "enum": [
            "met",
            "not_met",
            "unverified",
            "defined",
            "deviates"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^F\\d{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "criterion_id": {
          "anyOf": [
            {
              "pattern": "^AC\\d{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criterion Id"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "related_tickets": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Related Tickets",
          "type": "array"
        }
      },
      "required": [
        "id",
        "severity",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FootprintProposal": {
      "additionalProperties": false,
      "description": "Worker-proposed change footprint (planning). The coordinator adds identity fields.",
      "properties": {
        "paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Paths",
          "type": "array"
        },
        "components": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Components",
          "type": "array"
        },
        "interfaces": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Interfaces",
          "type": "array"
        },
        "domain_models": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Domain Models",
          "type": "array"
        },
        "schemas": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Schemas",
          "type": "array"
        },
        "migrations": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Migrations",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Dependencies",
          "type": "array"
        },
        "ticket_dependencies": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Ticket Dependencies",
          "type": "array"
        },
        "sequencing_notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Sequencing Notes",
          "type": "string"
        }
      },
      "title": "FootprintProposal",
      "type": "object"
    },
    "NextStep": {
      "additionalProperties": false,
      "description": "Something a person must do now that the blocker could not be cleared from the session.\n\nThe coordinator checks every step against the ticket before accepting the result (see\ndelivery.resolution.check_next_steps): a comment must be one it would recognise, with the\nticket's current token; an action must be one Jira offers on a Blocked ticket.",
      "properties": {
        "kind": {
          "enum": [
            "jira_comment",
            "jira_action",
            "command",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "who": {
          "default": "the developer",
          "maxLength": 80,
          "title": "Who",
          "type": "string"
        },
        "why": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Why",
          "type": "string"
        },
        "verified_by": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Verified By",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "why",
        "verified_by"
      ],
      "title": "NextStep",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "completed",
        "needs_clarification",
        "failed",
        "blocked"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "ProposedTicket": {
      "additionalProperties": false,
      "description": "A ticket Claude proposes (a slice of a ticket too big for one delivery, or a spike's\nfollow-up). Created in Jira only when a person asks for it with ``CREATE TICKETS``.",
      "properties": {
        "id": {
          "pattern": "^S\\d{1,2}$",
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "description": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "issue_type": {
          "default": "",
          "maxLength": 60,
          "title": "Issue Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary",
        "description"
      ],
      "title": "ProposedTicket",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^Q\\d{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "maxLength": 2000,
          "title": "Rationale",
          "type": "string"
        },
        "material": {
          "default": true,
          "title": "Material",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "Question",
      "type": "object"
    },
    "ReleaseProposal": {
      "additionalProperties": false,
      "properties": {
        "candidate_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Candidate Sha",
          "type": "string"
        },
        "smoke_steps": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Smoke Steps",
          "type": "array"
        },
        "rollback_steps": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Rollback Steps",
          "type": "array"
        }
      },
      "required": [
        "candidate_sha"
      ],
      "title": "ReleaseProposal",
      "type": "object"
    },
    "ResolutionDecision": {
      "additionalProperties": false,
      "description": "A choice made while resolving a blocker, and who made it.",
      "properties": {
        "id": {
          "pattern": "^D\\d{1,2}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "decision": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        },
        "decided_by": {
          "enum": [
            "developer",
            "claude"
          ],
          "title": "Decided By",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "maxLength": 1000,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "decision",
        "decided_by"
      ],
      "title": "ResolutionDecision",
      "type": "object"
    },
    "ResolutionReport": {
      "additionalProperties": false,
      "description": "What a resolve-blocker session did, for the ticket's Jira comment.",
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Actions",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/ResolutionDecision"
          },
          "maxItems": 30,
          "title": "Decisions",
          "type": "array"
        },
        "follow_ups": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Follow Ups",
          "type": "array"
        },
        "next_steps": {
          "items": {
            "$ref": "#/$defs/NextStep"
          },
          "maxItems": 10,
          "title": "Next Steps",
          "type": "array"
        }
      },
      "title": "ResolutionReport",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "blocker",
        "major",
        "minor",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Stage": {
      "enum": [
        "refinement",
        "planning",
        "development",
        "verification",
        "release_preparation",
        "release_verification",
        "resolution"
      ],
      "title": "Stage",
      "type": "string"
    },
    "WorkerCheck": {
      "additionalProperties": false,
      "description": "Informational only. Coordinator and CI evidence are authoritative.",
      "properties": {
        "name": {
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        },
        "command": {
          "default": "",
          "maxLength": 500,
          "title": "Command",
          "type": "string"
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ],
          "title": "Result",
          "type": "string"
        },
        "summary": {
          "default": "",
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "name",
        "result"
      ],
      "title": "WorkerCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "contract_id": {
      "maxLength": 80,
      "title": "Contract Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "ticket_key": {
      "pattern": "^[A-Z][A-Z0-9_]{1,9}-\\d{1,9}$",
      "title": "Ticket Key",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "procedure": {
      "maxLength": 40,
      "title": "Procedure",
      "type": "string"
    },
    "input_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Revision",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 200,
      "title": "Artifacts",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "maxItems": 50,
      "title": "Questions",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 200,
      "title": "Findings",
      "type": "array"
    },
    "deviations": {
      "items": {
        "$ref": "#/$defs/Deviation"
      },
      "maxItems": 50,
      "title": "Deviations",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 200,
      "title": "Evidence",
      "type": "array"
    },
    "worker_checks": {
      "items": {
        "$ref": "#/$defs/WorkerCheck"
      },
      "maxItems": 50,
      "title": "Worker Checks",
      "type": "array"
    },
    "footprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/FootprintProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "release": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proposed_tickets": {
      "items": {
        "$ref": "#/$defs/ProposedTicket"
      },
      "maxItems": 20,
      "title": "Proposed Tickets",
      "type": "array"
    },
    "blocker_reason": {
      "default": "",
      "maxLength": 2000,
      "title": "Blocker Reason",
      "type": "string"
    },
    "resolution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolutionReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "contract_id",
    "run_id",
    "ticket_key",
    "stage",
    "procedure",
    "input_revision",
    "outcome",
    "summary"
  ],
  "title": "StageResult",
  "type": "object"
}
